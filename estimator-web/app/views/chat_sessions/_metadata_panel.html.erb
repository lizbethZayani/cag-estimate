<%# Local: chat_session, max_turns (Integer or nil), latest_estimation (Estimation or nil). %>
<% metadata = chat_session.latest_metadata_hash %>
<% payload  = latest_estimation&.response_payload || {} %>
<% blank    = tag.span("Not mentioned yet", class: "text-white/40") %>
<aside data-panel="memory" aria-label="Conversation memory" class="lg:sticky lg:top-6 lg:self-start p-5 rounded-md bg-ink/30 border border-white/10">
  <h2 class="text-lg font-bold tracking-tight text-white mb-4">Memory</h2>

  <dl class="space-y-4 text-sm">
    <div>
      <dt class="text-xs uppercase tracking-tight text-white/50 font-bold">Project</dt>
      <dd data-memory="project-name" class="font-bold text-white mt-1"><%= metadata["project_name"].presence || blank %></dd>
    </div>
    <div>
      <dt class="text-xs uppercase tracking-tight text-white/50 font-bold">Team size</dt>
      <dd data-memory="team-size" class="text-white/90 mt-1"><%= metadata["assumed_team_size"].presence || blank %></dd>
    </div>
    <div>
      <dt class="text-xs uppercase tracking-tight text-white/50 font-bold">Technologies</dt>
      <dd class="mt-1">
        <% if metadata["mentioned_technologies"].any? %>
          <ul class="flex flex-wrap gap-2">
            <% metadata["mentioned_technologies"].each do |tech| %>
              <li data-memory="technology" class="text-xs font-bold px-2 py-1 rounded bg-brand text-ink-dark"><%= tech %></li>
            <% end %>
          </ul>
        <% else %>
          <%= blank %>
        <% end %>
      </dd>
    </div>
    <div>
      <dt class="text-xs uppercase tracking-tight text-white/50 font-bold">Agreed scope</dt>
      <dd data-memory="scope" class="text-white/90 mt-1 whitespace-pre-line break-words"><%= metadata["agreed_scope"].presence || blank %></dd>
    </div>
    <div>
      <dt class="text-xs uppercase tracking-tight text-white/50 font-bold">Turns</dt>
      <dd data-memory="turns" class="text-white/90 mt-1"><%= max_turns ? "#{chat_session.turn_count} of #{max_turns}" : chat_session.turn_count %></dd>
    </div>
    <% if payload["resolved_tier"].present? %>
      <div>
        <dt class="text-xs uppercase tracking-tight text-white/50 font-bold">Audience (last answer)</dt>
        <dd data-memory="tier" class="text-white/90 mt-1"><%= payload["resolved_tier"] %> <span class="text-white/50">(rule: <%= payload["tier_rule"] %>)</span></dd>
      </div>
    <% end %>
  </dl>

  <p class="text-xs text-white/50 mt-5 leading-relaxed">
    This memory is kept separately from the sliding-window history: the window forgets old turns, these facts stay.
  </p>

  <%= button_to "New conversation", chat_session_path(chat_session), method: :delete,
        form: { data: { turbo_confirm: "Start a new conversation? The current memory will be cleared. Past estimates stay in History." }, class: "mt-5" },
        class: "w-full px-4 py-2 rounded-md border border-white/30 text-white font-bold tracking-tight hover:border-brand hover:text-brand-soft cursor-pointer transition-colors" %>
</aside>
