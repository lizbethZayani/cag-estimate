<% result = @response.result %>
<% summary = result.summary %>
<section class="max-w-4xl mx-auto px-4 py-8">
  <h1 class="text-2xl font-bold"><%= result.project_name %></h1>
  <p>
    <% if @response.cached %><span>Cached</span><% end %>
    <span>Prompt <%= @response.prompt_version %></span>
  </p>
  <p class="whitespace-pre-line"><%= result.meeting_summary %></p>

  <h2 class="text-xl font-semibold mt-6">Summary</h2>
  <dl>
    <dt>Total hours</dt><dd><%= number_with_delimiter(summary.total_hours) %> h</dd>
    <dt>Total cost</dt><dd><%= number_to_currency(summary.total_cost_usd, precision: 0) %></dd>
    <dt>Team size</dt><dd><%= summary.team_size %></dd>
    <dt>Duration</dt><dd><%= summary.estimated_duration_weeks %> weeks</dd>
    <dt>Hourly rate</dt><dd><%= number_to_currency(summary.hourly_rate, precision: 0) %>/h</dd>
  </dl>

  <h2 class="text-xl font-semibold mt-6">Tasks</h2>
  <table>
    <thead>
      <tr><th>#</th><th>Task</th><th>Complexity</th><th>Hours</th><th>Cost</th></tr>
    </thead>
    <tbody>
      <% result.tasks.each do |task| %>
        <tr>
          <td><%= task.task_id %></td>
          <td>
            <strong><%= task.name %></strong>
            <p><%= task.description %></p>
            <ul>
              <% task.includes.each do |item| %><li><%= item %></li><% end %>
            </ul>
          </td>
          <td><%= task.complexity %></td>
          <td><%= task.estimated_hours %></td>
          <td><%= number_to_currency(task.estimated_cost_usd, precision: 0) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <% if summary.assumptions.any? %>
    <h2 class="text-xl font-semibold mt-6">Assumptions</h2>
    <ul>
      <% summary.assumptions.each do |assumption| %><li><%= assumption %></li><% end %>
    </ul>
  <% end %>

  <p class="mt-6"><%= link_to "New estimation", new_estimation_path %> · <%= link_to "History", estimations_path %></p>
</section>
